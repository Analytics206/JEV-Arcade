# JEV-Arcade settings (the package, command and variables keep the name WikiRace)
#
# Copy this file to .env and fill in what you use. The same file configures
# both ways of running:
#   Python:  `uv run wikirace` (or `wikirace`, `python -m wikirace`) reads ./.env,
#            or the file `--env-file` / WIKIRACE_ENV_FILE names
#   Docker:  `docker compose up` hands .env to the container
# A variable set in your real environment wins over this file. Every setting
# is listed here; docs/design.md has the same table with more on each.
#
# A provider with no key is shown as unavailable, with what to set. You need
# at least one provider to race: any key below, or an Ollama you run yourself.
#
# Thinking levels: none | low | medium | high | xhigh | max
# Leave a level unset to send none, so the model thinks as it does by default.
# A racer's level is, first to last: what the race setup picks, the model's
# own `model@level` in *_MODELS, <PROVIDER>_THINKING, WIKIRACE_THINKING.
#
# *_MODELS is a comma-separated list of model ids. `model@level` pins that
# model's thinking level. Leave it empty for the defaults shown. The race
# setup can also take any other model id of a provider you have a key for.

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default: claude-haiku-4-5, claude-sonnet-5, claude-opus-5
ANTHROPIC_MODELS=
ANTHROPIC_THINKING=
# Only for a proxy or gateway that speaks the Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI ─────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Default: gpt-4.1-mini, o4-mini
OPENAI_MODELS=
OPENAI_THINKING=
# Any server that speaks OpenAI's Chat Completions API can stand in here.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenRouter (hundreds of models behind one key) ─────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default: deepseek/deepseek-v4-flash, minimax/minimax-m3
OPENROUTER_MODELS=
OPENROUTER_THINKING=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Ollama (your own local models; not bundled) ─────────────────────────────
# Point this at an Ollama you run: this machine or one on your network.
# Running WikiRace in Docker? localhost here still means your machine: it is
# rewritten to host.docker.internal inside the container. Set it empty to
# switch Ollama off.
OLLAMA_BASE_URL=http://localhost:11434
# Empty: every model your Ollama has pulled. Example: qwen3.5:9b@low, llama3.2
OLLAMA_MODELS=
OLLAMA_THINKING=
# Context window per request, in tokens. Ollama's own default is small enough
# to cut a big article's list of links. A page that still does not fit is
# shown as the links that do. Raise it if your GPU has the memory.
OLLAMA_NUM_CTX=16384
# Only for an Ollama behind an authenticating proxy.
# OLLAMA_API_KEY=

# ── TypeSafe (Jev: a judgment model that scores links instead of writing) ──
# https://typesafe.ai
TYPESAFE_API_KEY=
# Default: jev-1.13.0
TYPESAFE_MODELS=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# ── Everyone ───────────────────────────────────────────────────────────────
# Thinking level for every racer, unless a provider or model sets its own.
WIKIRACE_THINKING=

# ── The server ─────────────────────────────────────────────────────────────
# Where the page is served: http://localhost:8008 with this file as it is,
# http://localhost:8000 when the line is removed. In Docker, the port is the
# one published on this machine, and the server is reachable from this
# machine only.
WIKIRACE_PORT=8008
# WIKIRACE_HOST=127.0.0.1
# Race history (SQLite). In Docker it lives on a volume instead.
# WIKIRACE_DB=data/wikirace.db
# Races that may run at once.
# WIKIRACE_MAX_RACES=2
# The page answers to localhost and 127.0.0.1. Opening it under another name
# or address (from another machine on your network, say)? Add it here, or *.
# WIKIRACE_ALLOWED_HOSTS=wikirace.lan, 192.168.1.20
# On a domain of your own, behind a proxy or tunnel: the one public address.
# It and its www. twin are answered to; www. and plain http redirect to it.
# WIKIRACE_CANONICAL_HOST=example.com
# A folder of your site's own files, served at its root after the page's own:
# a search console's verification file, say. site-root/ is ignored by git.
# WIKIRACE_SITE_ROOT=site-root
# Wikipedia asks every client to say who runs it; put your contact here.
# WIKIRACE_USER_AGENT=wikirace/0.1.0 (you@example.com)
